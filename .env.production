# Application
APP_NAME="LMS"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://neetaq.com

# Database
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=lms
DB_USERNAME=lms_user
DB_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD

# Cache & Queue
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# Octane (Production - محسّن)
OCTANE_SERVER=swoole
SWOOLE_HTTP_HOST=0.0.0.0
SWOOLE_HTTP_PORT=8000
SWOOLE_HTTP_WORKERS=4
SWOOLE_HTTP_TASK_WORKERS=6
SWOOLE_HTTP_MAX_REQUEST=500
SWOOLE_HTTP_WATCH=false

# Telescope (معطّل في Production)
TELESCOPE_ENABLED=false

# Firebase
GOOGLE_APPLICATION_CREDENTIALS=/var/www/backend/storage/firebase-credentials.json
FIREBASE_PROJECT_ID=neetaq-54091
FIREBASE_DATABASE_URL=https://neetaq-54091.firebaseio.com

# Cloudflare
CLOUDFLARE_API_TOKEN=CHANGE_THIS_CLOUDFLARE_TOKEN
CLOUDFLARE_ZONE_ID=CHANGE_THIS_ZONE_ID

# Frontend
NEXT_PUBLIC_API_URL=https://neetaq.com
NEXT_PUBLIC_FIREBASE_API_KEY=CHANGE_THIS_FIREBASE_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=neetaq-54091.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=neetaq-54091
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=neetaq-54091.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=CHANGE_THIS_SENDER_ID
NEXT_PUBLIC_FIREBASE_APP_ID=CHANGE_THIS_APP_ID

# Production Security
DB_ROOT_PASSWORD=CHANGE_THIS_ROOT_PASSWORD
