# ============================================
# Neetaq LMS - Production Environment
# ============================================
# Copy this file to .env.production and update with your values
# DO NOT commit .env.production to version control

# ============================================
# Application
# ============================================
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:CHANGE_THIS_TO_YOUR_PRODUCTION_APP_KEY

# ============================================
# HTTP Ports
# ============================================
APP_HTTP_PORT=80
APP_HTTPS_PORT=443

# ============================================
# Database
# ============================================
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=CHANGE_THIS
DB_USERNAME=CHANGE_THIS
DB_PASSWORD=CHANGE_THIS
DB_ROOT_PASSWORD=CHANGE_THIS

# ============================================
# Redis
# ============================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_THIS
REDIS_COMMAND=redis-server --requirepass ${REDIS_PASSWORD}

# ============================================
# Cache & Session
# ============================================
CACHE_DRIVER=redis
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# ============================================
# Laravel Octane (Production)
# ============================================
OCTANE_SERVER=swoole
SWOOLE_HTTP_HOST=0.0.0.0
SWOOLE_HTTP_PORT=8000
SWOOLE_HTTP_WORKERS=4
SWOOLE_HTTP_TASK_WORKERS=6
SWOOLE_HTTP_MAX_REQUEST=500
SWOOLE_HTTP_WATCH=false

# ============================================
# Laravel Reverb (WebSocket)
# ============================================
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=CHANGE_THIS
REVERB_APP_KEY=CHANGE_THIS
REVERB_APP_SECRET=CHANGE_THIS

# ============================================
# Frontend URLs
# ============================================
NEXT_PUBLIC_API_URL=https://api.neetaq.com
REVERB_PUBLIC_HOST=neetaq.com

# ============================================
# Next.js Reverb (Public)
# ============================================
NEXT_PUBLIC_REVERB_APP_KEY=CHANGE_THIS
NEXT_PUBLIC_REVERB_HOST=neetaq.com
NEXT_PUBLIC_REVERB_PORT=443
NEXT_PUBLIC_REVERB_SCHEME=https

# ============================================
# Firebase
# ============================================
FIREBASE_PROJECT_ID=CHANGE_THIS

NEXT_PUBLIC_FIREBASE_API_KEY=CHANGE_THIS
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=CHANGE_THIS
NEXT_PUBLIC_FIREBASE_PROJECT_ID=CHANGE_THIS
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=CHANGE_THIS
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=CHANGE_THIS
NEXT_PUBLIC_FIREBASE_APP_ID=CHANGE_THIS
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=CHANGE_THIS

# ============================================
# Cloudflare R2 (S3-Compatible Storage)
# ============================================
CLOUDFLARE_R2_ACCESS_KEY_ID=CHANGE_THIS
CLOUDFLARE_R2_SECRET_ACCESS_KEY=CHANGE_THIS
CLOUDFLARE_R2_BUCKET=CHANGE_THIS
CLOUDFLARE_R2_ENDPOINT=CHANGE_THIS
CLOUDFLARE_R2_PUBLIC_URL=CHANGE_THIS

# ============================================
# Cloudflare KV (Key-Value Store)
# ============================================
CLOUDFLARE_KV_ACCOUNT_ID=CHANGE_THIS
CLOUDFLARE_KV_NAMESPACE_ID=CHANGE_THIS
CLOUDFLARE_KV_API_TOKEN=CHANGE_THIS
