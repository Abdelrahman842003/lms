FROM phpswoole/swoole:5.1-php8.3

RUN apt-get update && apt-get install -y \
    git curl libpng-dev libonig-dev libxml2-dev \
    zip unzip libzip-dev libpq-dev \
    && docker-php-ext-install pdo_mysql mbstring exif pcntl bcmath gd zip \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/backend

# Development: composer install will run via volume mount
EXPOSE 8000

# Development: مع --watch للـ hot reload
CMD ["sh", "-c", "composer install && php artisan octane:start --server=swoole --host=0.0.0.0 --port=8000 --watch"]
