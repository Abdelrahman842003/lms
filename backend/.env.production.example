# ===========================================
# BACKEND PRODUCTION ENVIRONMENT (COOLIFY)
# ===========================================

# --- Application ---
APP_NAME="LMS Production"
APP_ENV=production
APP_KEY= # Generate using: php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://api.your-domain.com

# --- Database (Docker Internal) ---
DB_CONNECTION=mysql
DB_HOST=database
DB_PORT=3306
DB_DATABASE=lms
DB_USERNAME=lms_user
DB_PASSWORD= # Strong password required

# --- Redis & Cache ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD= # Strong password required
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# --- Broadcasting (Reverb Production) ---
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb.your-domain.com
REVERB_PORT=443
REVERB_SCHEME=https

# --- Cloudflare R2 (Storage) ---
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_PUBLIC_URL=

# --- Firebase (FCM) ---
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=/var/www/backend/storage/app/firebase-auth.json

# --- Security & Optimization ---
OCTANE_SERVER=swoole
SWOOLE_HTTP_WORKERS=4
SWOOLE_HTTP_TASK_WORKERS=6
TELESCOPE_ENABLED=false
